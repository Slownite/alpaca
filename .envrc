# Load the flake's default dev shell: python 3.12 + uv + ipython (impure uv workflow).
# Requires nix-direnv (the repo already gitignores its .direnv/ cache).
# For the pure, Nix-built shell instead, change this line to: use flake .#nix
use flake

# Activate the uv-managed virtualenv once it exists (run `just sync` to create it),
# so this shell — and editors via direnv — pick up the project interpreter directly.
if [ -d .venv ]; then
  source .venv/bin/activate
fi

# Pick up any local, untracked overrides (e.g. HF_TOKEN, API keys).
dotenv_if_exists .env
